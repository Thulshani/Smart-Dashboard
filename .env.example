# Copy this file to .env and fill in your real values.
# .env is already in .gitignore — never commit your real token.

# SonarCloud personal access token (Account -> Security -> Generate Token)
SONAR_TOKEN=38f67d8fcae940a7267d31c22674089f86669b53

# SonarCloud project key — visible in the URL when viewing your project,
# e.g. sonarcloud.io/component_measures?id=Thulshani_Smart-Dashboard
# -> the project key is "Thulshani_Smart-Dashboard"
SONAR_PROJECT_KEY=Thulshani_Smart-Dashboard
GITHUB_OWNER=Thulshani
GITHUB_REPO=Smart-Dashboard
# Secret used to sign login sessions. Use a long random string.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=163ed2655de74c8e3ab33521b197e144425ae233f44b453b7d1d04f648ad58fc
